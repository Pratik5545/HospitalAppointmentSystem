@model HospitalAppointmentSystem.Models.Doctor
@{
    ViewData["Title"] = "Appointment Confirmed";
    DateTime appointmentDate = ViewBag.AppointmentDate is DateTime dt ? dt : DateTime.Now;
    string patientName = ViewBag.PatientName as string ?? "Guest";
    string reason = ViewBag.Reason as string ?? "Not specified";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom p-4 p-md-5 text-center">
            <div class="mb-3">
                <span style="font-size: 3rem;">✅</span>
            </div>
            <h2 class="fw-bold text-success mb-2">Appointment Request Submitted!</h2>
            <p class="text-muted mb-4">
                Your request has been received by MediCare Hospital. Here are your booking details:
            </p>

            <div class="card bg-light border-0 text-start p-4 mb-4 rounded-3">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Patient Name (from Cookie):</small>
                        <strong class="fs-6 text-dark">@patientName</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Doctor Assigned (via Hidden Field):</small>
                        <strong class="fs-6 text-dark">@Model.DoctorName (#@Model.DoctorId)</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Specialization:</small>
                        <span class="badge bg-primary">@Model.Specialization</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Scheduled Date:</small>
                        <strong class="fs-6 text-dark">@appointmentDate.ToString("dddd, dd MMMM yyyy")</strong>
                    </div>
                    <div class="col-12">
                        <small class="text-muted d-block">Reason for Visit:</small>
                        <div class="p-2 bg-white rounded border text-secondary mt-1">@reason</div>
                    </div>
                    <div class="col-12 border-top pt-2 mt-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">Estimated Charges (Fee + ₹100 Service Fee):</small>
                            <span class="fw-bold text-success fs-5">₹@Model.CalculateTotalCharge().ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-primary px-4">
                    Back to Doctor Directory
                </a>
                <a asp-controller="Posts" asp-action="Index" class="btn btn-outline-secondary px-4">
                    View Hospital Bulletins
                </a>
            </div>
        </div>
    </div>
</div>
