@model List<HospitalAppointmentSystem.Models.Doctor>
@{
    ViewData["Title"] = "Doctor Directory & Appointments";
    var specializations = (List<string>)(ViewBag.Specializations ?? new List<string>());
    string? patientName = ViewBag.PatientName as string;
    string? selectedSpec = ViewBag.Specialization as string;
}

<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <h1 class="h2 fw-bold text-dark mb-1">Doctor Directory</h1>
        <p class="text-secondary mb-0">Browse specialized doctors and schedule your appointment seamlessly.</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 p-2">
            ⚡ Cached with <code>IMemoryCache</code> (3-Min Expiration)
        </span>
    </div>
</div>

<!-- State Management Card: Cookies & Sessions -->
<div class="card card-custom p-4 mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
        <h5 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
            <span>👤</span> Patient Preferences & State Management
        </h5>
        <div class="d-flex gap-2">
            <span class="badge bg-info text-dark">Cookie: Patient Name</span>
            <span class="badge bg-warning text-dark">Session: Specialization</span>
        </div>
    </div>

    <form asp-action="SetPreferences" method="post" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label fw-semibold small text-muted">Patient Name (Saved in Cookie)</label>
            <div class="input-group">
                <span class="input-group-text bg-light">👤</span>
                <input type="text" name="patientName" class="form-control"
                       placeholder="Enter your name (e.g. John Doe)" value="@patientName" required />
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold small text-muted">Specialization Filter (Saved in Session)</label>
            <div class="input-group">
                <span class="input-group-text bg-light">🩺</span>
                <select name="specialization" class="form-select">
                    <option value="">All Specializations</option>
                    @foreach (var spec in specializations)
                    {
                        <option value="@spec" selected="@(spec.Equals(selectedSpec, StringComparison.OrdinalIgnoreCase))">@spec</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                Save & Filter
            </button>
            @if (!string.IsNullOrEmpty(patientName) || !string.IsNullOrEmpty(selectedSpec))
            {
                <button type="submit" formaction="@Url.Action("ClearPreferences")" class="btn btn-outline-secondary" title="Clear Cookie & Session">
                    Reset
                </button>
            }
        </div>
    </form>

    @if (!string.IsNullOrEmpty(patientName) || !string.IsNullOrEmpty(selectedSpec))
    {
        <div class="mt-3 p-3 bg-light rounded-3 d-flex flex-wrap align-items-center justify-content-between gap-2 border">
            <div>
                @if (!string.IsNullOrEmpty(patientName))
                {
                    <span class="me-3">
                        Welcome back, <strong class="text-primary">@patientName</strong>
                        <span class="badge bg-primary-subtle text-primary border ms-1">From Cookie</span>
                    </span>
                }
                @if (!string.IsNullOrEmpty(selectedSpec))
                {
                    <span>
                        Filter active: <strong class="text-success">@selectedSpec</strong>
                        <span class="badge bg-success-subtle text-success border ms-1">From Session</span>
                    </span>
                }
                else
                {
                    <span class="text-muted small">Showing all doctor specialties</span>
                }
            </div>
        </div>
    }
</div>

<!-- Doctors Table -->
<div class="card card-custom overflow-hidden">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Available Doctors (@Model.Count)</h5>
        <span class="text-muted small">₹100 service charge calculated via Extension Method</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 70px;">ID</th>
                    <th scope="col">Doctor Name</th>
                    <th scope="col">Specialization</th>
                    <th scope="col">Experience</th>
                    <th scope="col" class="text-end">Consultation Fee</th>
                    <th scope="col" class="text-end">Total Charge (incl. ₹100 Service Fee)</th>
                    <th scope="col" class="text-center" style="width: 150px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var doctor in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@doctor.DoctorId</td>
                            <td>
                                <div class="fw-bold text-dark">@doctor.DoctorName</div>
                            </td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                                    @doctor.Specialization
                                </span>
                            </td>
                            <td>@doctor.Experience yrs</td>
                            <td class="text-end text-muted">₹@doctor.ConsultationFee.ToString("N0")</td>
                            <td class="text-end">
                                <span class="fw-bold text-success fs-6">
                                    ₹@doctor.CalculateTotalCharge().ToString("N0")
                                </span>
                                <div class="text-muted" style="font-size: 0.72rem;">(₹@doctor.ConsultationFee + ₹100)</div>
                            </td>
                            <td class="text-center">
                                <!-- Query String: Passing doctorId via asp-route-doctorId -->
                                <a asp-action="Details" asp-route-doctorId="@doctor.DoctorId" class="btn btn-sm btn-outline-primary px-3">
                                    Details &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No doctors found matching the selected specialization. Try selecting "All Specializations".
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
