@model List<HospitalAppointmentSystem.Models.Post>
@{
    ViewData["Title"] = "Hospital Bulletins & Posts";
    string? error = ViewBag.Error as string;
}

<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <h1 class="h2 fw-bold text-dark mb-1">Hospital Bulletins & Posts</h1>
        <p class="text-secondary mb-0">Public advisory feed fetched asynchronously from external API.</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 p-2">
            🌐 Asynchronous Web Request (<code>IHttpClientFactory</code>)
        </span>
    </div>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
        <span>⚠️</span>
        <div>@error</div>
    </div>
}

<div class="card card-custom overflow-hidden">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0 text-dark">External Posts Feed</h5>
            <small class="text-muted">Source: <code>https://jsonplaceholder.typicode.com/posts</code></small>
        </div>
        <span class="badge bg-secondary">Total: @Model.Count posts</span>
    </div>

    <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light sticky-top">
                <tr>
                    <th scope="col" style="width: 100px;">Post ID</th>
                    <th scope="col">Title</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var post in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border">#@post.Id</span>
                            </td>
                            <td>
                                <span class="fw-medium text-dark text-capitalize">@post.Title</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="text-center py-4 text-muted">
                            No posts found or waiting for data.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
